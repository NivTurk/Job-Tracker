# Copy to .env and fill in. .env is gitignored.

# Where the database and uploaded CVs live (relative to the repo root, or absolute).
DATA_DIR=data

# The web server binds here. Keep 127.0.0.1 unless you know why you need otherwise.
HOST=127.0.0.1
PORT=8000

# Used for links in Telegram messages (phase 3).
BASE_URL=http://127.0.0.1:8000

# Phase 2: AI half of the ATS score and job search.
ANTHROPIC_API_KEY=

# Phase 3: follow-up reminders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
